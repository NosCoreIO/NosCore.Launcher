<Window x:Class="NosCore.Launcher.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}">

    <StackPanel Margin="20">
        <TextBlock Text="NostaleClientX.exe" Style="{StaticResource FieldLabel}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ClientPathBox" Grid.Column="0" />
            <Button Grid.Column="1" Content="Browse" Style="{StaticResource DialogButton}"
                    Margin="8,0,0,0" Click="OnBrowseClient" />
        </Grid>
        <TextBlock Style="{StaticResource DialogText}" FontSize="11" Margin="0,6,0,0"
                   Text="Left untouched. Every launch writes a freshly patched copy beside it." />

        <TextBlock Text="Patched client filename" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox x:Name="PatchedNameBox" />

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Region" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="RegionBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Locale" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LocaleBox" />
            </StackPanel>
        </Grid>

        <TextBlock Text="Launcher config URL" Style="{StaticResource FieldLabel}" Margin="0,14,0,4" />
        <TextBox x:Name="ConfigUrlBox" />
        <TextBlock Style="{StaticResource DialogText}" FontSize="11" Margin="0,6,0,0"
                   Text="Hosted launcher.json with the server branding, news and login address. Blank means offline defaults." />

        <TextBlock x:Name="ErrorText" Style="{StaticResource DialogError}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Click="OnCancel"
                    Margin="0,0,8,0" />
            <Button Content="Save" Style="{StaticResource DialogButton}" IsDefault="True" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
