<Window x:Class="NosCore.Launcher.Views.LoginDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in"
        Width="360" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Panel}">

    <StackPanel Margin="20">
        <TextBlock Text="Sign in to your NosCore account" Style="{StaticResource DialogText}"
                   Foreground="{StaticResource Text}" Margin="0,0,0,16" />

        <TextBlock Text="Login or email" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="UsernameBox" />

        <TextBlock Text="Password" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <PasswordBox x:Name="PasswordBox" />

        <TextBlock Text="MFA code (leave blank if unused)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
        <TextBox x:Name="MfaBox" />

        <CheckBox x:Name="RememberBox" Content="Remember me" Margin="0,14,0,0" />

        <TextBlock x:Name="ErrorText" Style="{StaticResource DialogError}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource DialogButton}" IsCancel="True" Click="OnCancel"
                    Margin="0,0,8,0" />
            <Button Content="Sign in" Style="{StaticResource DialogButton}" IsDefault="True" Click="OnSubmit" />
        </StackPanel>
    </StackPanel>
</Window>
