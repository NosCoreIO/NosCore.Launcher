<Window x:Class="NosCore.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NosCore.Launcher.ViewModels"
        Title="NosCore Launcher"
        Width="960" Height="680"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">

    <Border CornerRadius="8" Background="{StaticResource Backdrop}" ClipToBounds="True">
        <Grid>
            <!-- Remote background sits over the gradient, so a missing or slow
                 image degrades to the theme instead of a blank window. -->
            <Image Source="{Binding BackgroundUrl}" Stretch="UniformToFill" Opacity="0.55" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title bar: the window is frameless, so this doubles as the drag handle. -->
                <Grid Grid.Row="0" Height="38" Background="#59080C16" MouseLeftButtonDown="OnChromeDrag">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Margin="16,0,0,0"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding AccountLabel}" Command="{Binding AccountCommand}"
                                Style="{StaticResource ChromeButton}" Width="Auto" Padding="12,0"
                                ToolTip="Sign in or out" />
                        <Button Content="Settings" Command="{Binding EditSettingsCommand}"
                                Style="{StaticResource ChromeButton}" Width="Auto" Padding="12,0" />
                        <Button Content="&#x2715;" Click="OnClose" Style="{StaticResource ChromeButton}"
                                ToolTip="Close" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="24,18,24,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: branding, nav, ads, play -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource Heading}" />

                        <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Body}"
                                   Margin="0,10,40,0" />

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding Links}" Margin="0,18,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:LinkItem}">
                                    <Button Content="{Binding Label}"
                                            Style="{StaticResource LinkButton}"
                                            Margin="0,0,20,0"
                                            Command="{Binding DataContext.OpenUrlCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Url}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Ads carousel: one visible panel plus a dot strip. Hidden
                             entirely when the config ships no ads, so no empty frame. -->
                        <Grid Grid.Row="3" VerticalAlignment="Bottom" Margin="0,20,0,0"
                              Visibility="{Binding CurrentAd, Converter={StaticResource NullToCollapsed}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Style="{StaticResource LinkButton}" Height="128"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding CurrentAd.Url}"
                                    ToolTip="{Binding CurrentAd.Description}">
                                <Border CornerRadius="6" ClipToBounds="True" Background="#40000000">
                                    <Grid>
                                        <Image Source="{Binding CurrentAd.ImageUrl}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Bottom" Background="#A6080C16" Padding="10,6"
                                                Visibility="{Binding CurrentAd.Description,
                                                            Converter={StaticResource EmptyToCollapsed}}">
                                            <TextBlock Text="{Binding CurrentAd.Description}"
                                                       FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Ads}" HorizontalAlignment="Center"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AdItem}">
                                        <Button Style="{StaticResource LinkButton}" Margin="4,0" Padding="0"
                                                Command="{Binding DataContext.SelectAdCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="{Binding Description}">
                                            <Ellipse Width="7" Height="7" Fill="{StaticResource TextMuted}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>

                        <Button Grid.Row="4" Content="PLAY" Style="{StaticResource PrimaryButton}"
                                Command="{Binding PlayCommand}" Margin="0,20,0,0" />
                    </Grid>

                    <!-- Right: news -->
                    <Border Grid.Column="2" Style="{StaticResource Scrim}" Padding="16,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="NEWS" Style="{StaticResource SectionHeading}" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding News}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NewsItem}">
                                                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1"
                                                        Padding="0,8">
                                                    <Button Content="{Binding Headline}"
                                                            Style="{StaticResource LinkButton}"
                                                            IsEnabled="{Binding HasUrl}"
                                                            Command="{Binding DataContext.OpenUrlCommand,
                                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding Url}">
                                                        <Button.ContentTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                                                           FontSize="13" />
                                                            </DataTemplate>
                                                        </Button.ContentTemplate>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Stands in for the list rather than leaving a blank column. -->
                                    <TextBlock Text="Nothing to report right now."
                                               Style="{StaticResource Body}" Margin="0,8,0,0"
                                               Visibility="{Binding News.Count, Converter={StaticResource ZeroToVisible}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Status strip: the only place launch progress and failures surface. -->
                <Border Grid.Row="2" Padding="24,10,24,14" MinHeight="42">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Body}" FontSize="12"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
