<Window x:Class="NosCore.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NosCore.Launcher.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="NosCore Launcher"
        Width="960" Height="680"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <Border CornerRadius="6" ClipToBounds="True">
        <Grid>
            <!-- Drawn backdrop is the floor; a hosted BackgroundUrl paints over
                 it, so a slow or missing download degrades to this rather than
                 to nothing. The ridges are authored in a fixed 960x680 space and
                 stretched, so they hold their shape when the window clamps to a
                 smaller work area. -->
            <Grid>
                <Rectangle Fill="{StaticResource BackdropSky}" />
                <Rectangle Fill="{StaticResource BackdropGlow}" />
                <Viewbox Stretch="Fill">
                <Canvas Width="960" Height="680" ClipToBounds="True" Background="Transparent">
                    <Ellipse Canvas.Left="441" Canvas.Top="301" Width="58" Height="58" Fill="#FFFFF4DC" />
                    <Path Fill="{StaticResource RidgeFar}"
                          Data="M0,470 L120,392 L206,438 L316,352 L430,444 L520,396 L640,468 L742,414 L860,470 L960,430 L960,680 L0,680 Z" />
                    <Path Fill="{StaticResource RidgeMid}"
                          Data="M0,540 L96,486 L204,540 L300,470 L412,546 L536,486 L640,552 L768,498 L880,556 L960,514 L960,680 L0,680 Z" />
                    <Path Fill="{StaticResource RidgeNear}"
                          Data="M0,604 L140,558 L268,608 L392,552 L512,614 L648,564 L790,618 L900,578 L960,606 L960,680 L0,680 Z" />
                </Canvas>
                </Viewbox>
                <Rectangle Fill="{StaticResource BackdropVignette}" />
            </Grid>
            <Image Source="{Binding BackgroundUrl}" Stretch="UniformToFill" />

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Frameless, so the bar doubles as the drag handle. -->
                <!-- No title text here: the heading below already carries the
                     server name, and repeating it reads as a duplicate rather
                     than as chrome. The bar stays as the drag strip. -->
                <Grid Grid.Row="0" Background="{StaticResource Wash40}" MouseLeftButtonDown="OnChromeDrag">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                        <TextBlock Text="{Binding Username}" VerticalAlignment="Center" FontSize="12"
                                   Margin="0,0,6,0"
                                   Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisible}}" />
                        <!-- Account glyph goes green once signed in, as the original did. -->
                        <Button Command="{Binding AccountCommand}" ToolTip="{Binding AccountLabel}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ChromeGlyph}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSignedIn}" Value="True">
                                            <Setter Property="Foreground" Value="#FF6FCF6F" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path Data="{StaticResource IconAccount}" Style="{StaticResource ChromeIcon}" />
                        </Button>
                        <Button Command="{Binding EditSettingsCommand}" Style="{StaticResource ChromeGlyph}"
                                ToolTip="Settings">
                            <Path Data="{StaticResource IconSettings}" Style="{StaticResource ChromeIcon}" />
                        </Button>
                        <Button Click="OnClose" Style="{StaticResource ChromeGlyph}" ToolTip="Close">
                            <Path Data="{StaticResource IconClose}" Style="{StaticResource ChromeIcon}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,40,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="7*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: branding, nav, play -->
                    <Grid Grid.Column="0" Margin="30,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource Heading}" />

                        <TextBlock Grid.Row="1" Text="{Binding Description}" Style="{StaticResource Body}"
                                   Margin="0,8,20,0" />

                        <!-- Pipe-separated nav inside a black wash, as before. -->
                        <Border Grid.Row="2" Background="{StaticResource Wash60}" CornerRadius="4"
                                Width="300" HorizontalAlignment="Left" Margin="50,40,0,0" Padding="10,5"
                                Visibility="{Binding Links.Count, Converter={StaticResource ZeroToCollapsed}}">
                            <ItemsControl ItemsSource="{Binding Links}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LinkItem}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="|" Margin="6,0" FontSize="14"
                                                       Foreground="{StaticResource TextDim}"
                                                       Visibility="{Binding IsFirst, Converter={StaticResource TrueToCollapsed}}" />
                                            <Button Content="{Binding Label}" Style="{StaticResource LinkButton}"
                                                    Command="{Binding DataContext.OpenUrlCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <Button Grid.Row="4" Content="PLAY" Style="{StaticResource PlayButton}"
                                Command="{Binding PlayCommand}" Margin="0,0,0,30" />
                    </Grid>

                    <!-- Right: news over ads, both 350 wide as before -->
                    <StackPanel Grid.Column="1" Width="350" HorizontalAlignment="Left" Margin="0,0,0,0">
                        <Border Background="{StaticResource Wash60}" Padding="10,8" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="NEWS" FontWeight="Bold" FontSize="12"
                                           Foreground="{StaticResource TextStrong}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding News}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NewsItem}">
                                            <Button Style="{StaticResource NewsLink}" Margin="0,3"
                                                    IsEnabled="{Binding HasUrl}"
                                                    Command="{Binding DataContext.OpenUrlCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding Url}">
                                                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap"
                                                           FontSize="12" Foreground="{Binding Path=Foreground,
                                                           RelativeSource={RelativeSource AncestorType=Button}}" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nothing to report right now." Style="{StaticResource Small}"
                                           FontWeight="Normal"
                                           Visibility="{Binding News.Count, Converter={StaticResource ZeroToVisible}}" />
                            </StackPanel>
                        </Border>

                        <!-- Collapses entirely when the config ships no ads. -->
                        <Grid Visibility="{Binding CurrentAd, Converter={StaticResource NullToCollapsed}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="200" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0" Style="{StaticResource LinkButton}"
                                    Command="{Binding OpenUrlCommand}"
                                    CommandParameter="{Binding CurrentAd.Url}"
                                    ToolTip="{Binding CurrentAd.Description}">
                                <Border CornerRadius="10" ClipToBounds="True" Background="{StaticResource Wash40}">
                                    <Grid>
                                        <Image Source="{Binding CurrentAd.ImageUrl}" Stretch="UniformToFill" />
                                        <Border VerticalAlignment="Bottom" Background="{StaticResource Wash40}"
                                                Padding="10,6,10,12"
                                                Visibility="{Binding CurrentAd.Description,
                                                            Converter={StaticResource EmptyToCollapsed}}">
                                            <TextBlock Text="{Binding CurrentAd.Description}" FontSize="16"
                                                       HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Button>

                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Ads}" HorizontalAlignment="Center"
                                          Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AdItem}">
                                        <Button Style="{StaticResource LinkButton}" Margin="4,0"
                                                Command="{Binding DataContext.SelectAdCommand,
                                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" ToolTip="{Binding Description}">
                                            <Ellipse Width="8" Height="8" Fill="White" Opacity="0.55" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Launch progress and failures surface here and nowhere else. -->
                <Border Grid.Row="2" Background="{StaticResource Wash40}" Padding="20,8" MinHeight="34"
                        Visibility="{Binding Status, Converter={StaticResource EmptyToCollapsed}}">
                    <TextBlock Text="{Binding Status}" Style="{StaticResource Small}" FontWeight="Normal"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
