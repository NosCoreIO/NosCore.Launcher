<Application x:Class="NosCore.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NosCore.Launcher.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <views:NullToCollapsedConverter x:Key="NullToCollapsed" />
            <views:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <views:ZeroToVisibleConverter x:Key="ZeroToVisible" />
            <views:ZeroToCollapsedConverter x:Key="ZeroToCollapsed" />
            <views:BoolToVisibleConverter x:Key="BoolToVisible" />
            <views:TrueToCollapsedConverter x:Key="TrueToCollapsed" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
